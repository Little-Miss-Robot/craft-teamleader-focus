{
  "name": "craftpulse/craft-teamleader",
  "description": "Teamleader plugin",
  "type": "craft-plugin",
  "version": "5.0.0",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "teamleader",
    "teamleader focus",
    "marketing",
    "lead generation"
  ],
  "support":{
    "email": "support@craftpulse.com",
    "docs": "https://github.com/craftpulse/craft-teamleader/blob/v5/README.md",
    "issues": "https://github.com/craftpulse/craft-teamleader/issues"
  },
  "license": "proprietary",
  "authors": [
    {
      "name": "CraftPulse",
      "email": "support@craftpulse.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2.0",
    "craftcms/cms": "^5.0.0",
    "league/oauth2-client": "^2.0.0"
  },
  "require-dev":{
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "yiisoft/yii2-redis": "^2.0",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "autoload": {
    "psr-4": {
      "craftpulse\\teamleader\\": "src/"
    }
  },
  "extra": {
    "name": "Teamleader",
    "handle": "teamleader",
    "developer": "CraftPulse",
    "developerUrl": "https://craftpulse.com",
    "documentationUrl": "https://github.com/craftpulse/craft-teamleader/blob/v5/README.md",
    "changelogUrl": "https://github.com/craftpulse/craft-teamleader/blob/v5/CHANGELOG.md",
    "class": "craftpulse\\teamleader\\Teamleader"
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
