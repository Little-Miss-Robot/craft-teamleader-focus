<div :class="'fui-field-layout-' + field.settings.layout">
    <div class="fui-field-radio">
        <input type="radio" :checked="field.settings.defaultValue === 'company'" disabled />
        <label>${ field.settings.companyLabel || 'Company' }</label>
    </div>
    <div class="fui-field-radio">
        <input type="radio" :checked="field.settings.defaultValue === 'contact'" disabled />
        <label>${ field.settings.contactLabel || 'Client' }</label>
    </div>
</div>
