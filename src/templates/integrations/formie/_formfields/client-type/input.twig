{% set defaultValue = field.defaultValue ?? 'company' %}

<div class="fui-layout-wrap fui-layout-{{ field.layout ?? 'horizontal' }}">
    {% for option in field.getFieldOptions() %}
        {% set optionContext = { option: option } %}

        {% set fieldOption = field.defineHtmlTag('fieldOption', optionContext) %}
        {% set fieldInput = field.defineHtmlTag('fieldInput', optionContext) %}
        {% set fieldOptionLabel = field.defineHtmlTag('fieldOptionLabel', optionContext) %}

        {% set isChecked = (value is not empty and value == option.value) or (value is empty and option.isDefault) %}

        <div {{ attr(fieldOption.attributes) }}>
            <input
                {{ attr(fieldInput.attributes) }}
                value="{{ option.value }}"
                {% if isChecked %}checked{% endif %}
            />

            <label {{ attr(fieldOptionLabel.attributes) }}>
                {{ option.label }}
            </label>
        </div>
    {% endfor %}
</div>
